# ---------------------------------------------------------------------------
# CityCare Backend — copy to .env and fill in real values. NEVER commit .env
# Generate each secret separately:  openssl rand -hex 64
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# --- Database (Neon / Supabase / local Postgres) ---------------------------
DATABASE_URL="postgresql://user:pass@host/citycare?sslmode=require"
TEST_DATABASE_URL=

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=
BCRYPT_SALT_ROUNDS=12

# --- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- SSLCommerz (sandbox) --------------------------------------------------
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (Upstash) -------------------------------------------------------
REDIS_URL=

# --- Email (Gmail app password) --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CityCare <no-reply@citycare.com>"

# --- Rate limits -----------------------------------------------------------
# These are the production posture. Walking the whole Postman collection is
# ~100 calls from one IP, so raise the global one while you demo:
#   RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=5

# --- Seed accounts ---------------------------------------------------------
ADMIN_EMAIL=admin@citycare.com
ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_EMAIL=admin@citycare.com
