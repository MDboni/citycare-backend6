// ---------------------------------------------------------------------------
// Organisation master data — Department -> Category (carries the SLA)
// ---------------------------------------------------------------------------

model Department {
  id         String     @id @default(uuid())
  name       String     @unique
  /// The public desk for this department. All three are optional and all three
  /// are editable from Taxonomy -> Departments, because the contact page prints
  /// whatever is here — so a number that changes is a record edit, not a deploy.
  email      String?
  phone      String?
  address    String?
  categories Category[]
  officers   User[]
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
}

model Category {
  id              String      @id @default(uuid())
  name            String      @unique
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  slaHours        Int         @default(72)
  defaultPriority Priority    @default(MEDIUM)
  complaints      Complaint[]
  deletedAt       DateTime?

  @@index([departmentId])
}
